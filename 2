
const express = require('express');
const app = express();

// Set EJS as templating engine
app.set('view engine', 'ejs');

// Route
app.get('/', (req, res) => {
    res.render('home', {
        name: 'Ravi',
        age: 20
    });
});

app.listen(3000, () => {
    console.log('Server running on port 3000');
});


