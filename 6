
import React, { useState } from 'react';

function Student(props) {
  const [marks, setMarks] = useState(80);

  return (
    <div>
      <h2>Student Details</h2>
      <p>Name: {props.name}</p>
      <p>Roll No: {props.rollno}</p>
      <p>Marks: {marks}</p>

      <button onClick={() => setMarks(marks + 5)}>
        Increase Marks
      </button>
    </div>
  );
}

function App() {
  return (
    <div>
      <Student name="Rahul" rollno="101" />
    </div>
  );
}

export default App;


  
